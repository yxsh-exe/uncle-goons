---
import Logo from './Logo.astro';
import { footerLinks } from '../data/site';

const socials = [
	{
		label: 'Instagram',
		path: 'M7 3h10a4 4 0 0 1 4 4v10a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V7a4 4 0 0 1 4-4Zm5 5a4 4 0 1 0 0 8 4 4 0 0 0 0-8Zm5.5-1.5h.01',
	},
	{ label: 'Facebook', path: 'M14 8h3V4h-3a4 4 0 0 0-4 4v3H7v4h3v6h4v-6h3l1-4h-4V8Z' },
	{ label: 'YouTube', path: 'M3 8a3 3 0 0 1 3-3h12a3 3 0 0 1 3 3v8a3 3 0 0 1-3 3H6a3 3 0 0 1-3-3V8Zm7 1v6l5-3-5-3Z' },
];
---

<footer id="contact" class="bg-navy text-white">
	<div class="checker h-4"></div>
	<div class="mx-auto flex max-w-7xl flex-col gap-8 px-4 py-10 sm:px-8 md:flex-row md:items-center md:justify-between">
		<div class="flex items-center gap-4">
			<Logo class="size-20" />
			<p class="max-w-[14rem] text-xs leading-relaxed text-white/70">
				Brownies, cookies &amp; cheesecakes.<br />Baked fresh since 1999.
			</p>
		</div>

		<nav aria-label="Footer">
			<ul class="flex flex-wrap gap-x-8 gap-y-3 text-xs font-semibold tracking-widest uppercase">
				{
					footerLinks.map((l) => (
						<li id={l === 'Franchise' ? 'franchise' : undefined}>
							<a href={`#${l.toLowerCase()}`} class="transition-opacity hover:opacity-70">{l}</a>
						</li>
					))
				}
			</ul>
		</nav>

		<ul class="flex gap-3">
			{
				socials.map((s) => (
					<li>
						<a
							href="#"
							aria-label={s.label}
							class="grid size-9 place-items-center rounded-full border border-white/30 transition-colors hover:bg-white hover:text-navy"
						>
							<svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true">
								<path d={s.path} />
							</svg>
						</a>
					</li>
				))
			}
		</ul>
	</div>
	<p class="border-t border-white/10 px-4 py-4 text-center text-[11px] text-white/50">
		© {new Date().getFullYear()} Uncle Goons. All rights reserved.
	</p>
</footer>
