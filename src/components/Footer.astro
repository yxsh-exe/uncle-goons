---
import LogoLockup from './LogoLockup.astro';
import { footerGroups } from '../data/site';

const socials = [
	{
		label: 'Instagram',
		path: 'M7 3h10a4 4 0 0 1 4 4v10a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V7a4 4 0 0 1 4-4Zm5 5a4 4 0 1 0 0 8 4 4 0 0 0 0-8Zm5.5-1.5h.01',
	},
	{ label: 'Facebook', path: 'M14 8h3V4h-3a4 4 0 0 0-4 4v3H7v4h3v6h4v-6h3l1-4h-4V8Z' },
	{ label: 'YouTube', path: 'M3 8a3 3 0 0 1 3-3h12a3 3 0 0 1 3 3v8a3 3 0 0 1-3 3H6a3 3 0 0 1-3-3V8Zm7 1v6l5-3-5-3Z' },
];
---

<footer id="contact" class="bg-navy text-white">
	<div class="checker h-5"></div>

	<div
		class="mx-auto grid max-w-7xl items-center gap-12 px-4 py-16 sm:px-8 md:grid-cols-[auto_1fr] md:gap-20 md:py-24"
	>
		<LogoLockup class="mx-auto w-56 md:w-72" />

		<div class="grid gap-10 sm:grid-cols-3">
			<div>
				<p class="font-display text-3xl leading-tight font-bold uppercase">
					Fudge first.<br /><span class="text-brand-red">Always.</span>
				</p>
				<p class="mt-4 max-w-xs text-sm leading-relaxed text-white/70">
					Brownies, cookies &amp; cheesecakes, baked fresh every morning since 1999.
				</p>
			</div>

			{
				footerGroups.map((group) => (
					<nav aria-label={group.title}>
						<p class="font-display text-lg font-semibold tracking-[0.2em] text-white/50 uppercase">{group.title}</p>
						<ul class="mt-4 flex flex-col gap-3 text-sm font-bold tracking-widest uppercase">
							{group.links.map((l) => (
								<li id={l.id}>
									<a href={l.href} class="transition-opacity hover:opacity-70">
										{l.label}
									</a>
								</li>
							))}
						</ul>
					</nav>
				))
			}
		</div>
	</div>

	<div class="border-t border-white/10">
		<div
			class="mx-auto flex max-w-7xl flex-col-reverse items-center gap-4 px-4 py-6 sm:flex-row sm:justify-between sm:px-8"
		>
			<p class="text-xs text-white/50">© {new Date().getFullYear()} Uncle Goons. All rights reserved.</p>
			<ul class="flex gap-3">
				{
					socials.map((s) => (
						<li>
							<a
								href="#"
								aria-label={s.label}
								class="grid size-11 place-items-center rounded-full border border-white/30 transition-colors hover:bg-white hover:text-navy"
							>
								<svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true">
									<path d={s.path} />
								</svg>
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</div>
</footer>
