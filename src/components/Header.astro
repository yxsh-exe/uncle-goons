---
import LogoLockup from './LogoLockup.astro';
import { navLinks } from '../data/site';
---

<header class="sticky top-0 z-50 bg-brand-red text-white shadow-sm">
	<div class="mx-auto flex h-24 max-w-7xl sm:h-28 items-center justify-between gap-6 px-4 sm:px-8">
		<a href="#top" aria-label="Uncle Goons home"><LogoLockup badge class="w-20 sm:w-24" /></a>

		<nav class="hidden md:block" aria-label="Main">
			<ul class="flex gap-8 font-display text-base font-medium tracking-wider uppercase">
				{navLinks.map((l) => <li><a href={l.href} class="transition-opacity hover:opacity-75">{l.label}</a></li>)}
			</ul>
		</nav>

		<div class="flex items-center gap-3">
			<a
				href="#menu"
				class="rounded-full bg-navy px-5 py-2 font-display text-base font-medium tracking-wider uppercase transition-colors hover:bg-navy-dark"
			>
				Order now
			</a>
			<button
				type="button"
				data-menu-toggle
				aria-expanded="false"
				aria-controls="mobile-nav"
				class="grid size-10 place-items-center rounded-full border border-white/40 md:hidden"
			>
				<span class="sr-only">Toggle navigation</span>
				<svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
					<path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round"></path>
				</svg>
			</button>
		</div>
	</div>

	<nav id="mobile-nav" data-mobile-nav hidden class="border-t border-white/20 md:hidden" aria-label="Mobile">
		<ul class="flex flex-col px-4 py-3 font-display text-lg font-medium tracking-wider uppercase">
			{navLinks.map((l) => <li><a href={l.href} class="block py-2.5">{l.label}</a></li>)}
		</ul>
	</nav>
</header>

<script>
	const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
	const nav = document.querySelector<HTMLElement>('[data-mobile-nav]');
	const setOpen = (open: boolean) => {
		toggle?.setAttribute('aria-expanded', String(open));
		if (nav) nav.hidden = !open;
	};
	toggle?.addEventListener('click', () => setOpen(nav?.hidden ?? false));
	nav?.addEventListener('click', (e) => {
		if ((e.target as HTMLElement).closest('a')) setOpen(false);
	});
</script>
