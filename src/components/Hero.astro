---
import Photo from './Photo.astro';
import { heroPhotos } from '../data/site';
---

<section class="mx-auto max-w-7xl px-4 pt-12 pb-16 sm:px-8 md:pt-16">
	<h1
		data-reveal
		class="flex flex-wrap items-center gap-x-[0.25em] gap-y-2 font-display text-[clamp(2.5rem,6.6vw,5.5rem)] leading-none font-bold uppercase lg:flex-nowrap lg:whitespace-nowrap"
	>
		<span class="text-brand-red">A Legacy</span>
		<span class="text-navy">For you to cherish</span>
	</h1>

	<div data-reveal class="mt-8 flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
		<p class="max-w-md text-sm leading-relaxed text-ink/80 sm:text-base">
			Fudgy brownies, gooey cookies and cheesecakes worth the detour. Baked fresh every morning and served warm with
			a scoop and a grin.
		</p>
		<div class="flex flex-wrap gap-3">
			<a
				href="#menu"
				class="inline-flex items-center gap-2 rounded-full bg-brand-red px-6 py-3 text-xs font-bold tracking-widest text-white uppercase transition-colors hover:bg-brand-red-dark"
			>
				Explore the menu <span aria-hidden="true">→</span>
			</a>
			<a
				href="#outlets"
				class="inline-flex items-center gap-2 rounded-full border-2 border-navy bg-white px-6 py-3 text-xs font-bold tracking-widest text-navy uppercase transition-colors hover:bg-navy hover:text-white"
			>
				Find an outlet <span aria-hidden="true">→</span>
			</a>
		</div>
	</div>

	<div class="mt-10 grid gap-4 sm:grid-cols-3">
		{heroPhotos.map((p) => <Photo data-reveal label={p.label} color={p.color} class="aspect-[4/3] sm:aspect-[5/4]" />)}
	</div>
</section>
