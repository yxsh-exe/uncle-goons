---
import Photo from './Photo.astro';
import { menu } from '../data/site';
---

<section id="menu" class="bg-blush py-16 md:py-24">
	<div class="mx-auto max-w-6xl px-4 sm:px-8">
		<h2 data-reveal class="font-display text-5xl font-bold text-navy uppercase sm:text-7xl">The menu</h2>

		<div class="mt-12 flex flex-col gap-16 md:gap-24">
			{
				menu.map((cat, i) => (
					<article class="grid items-center gap-8 md:grid-cols-2 md:gap-14">
						<Photo
							data-reveal
							label={cat.title}
							color={cat.color}
							class={`aspect-[4/3] rounded-3xl! shadow-lg ${i % 2 === 0 ? 'md:order-last' : ''}`}
						/>
						<div data-reveal>
							<h3 class="font-display text-3xl leading-none font-bold text-brand-red uppercase sm:text-4xl">{cat.title}</h3>
							<p class="mt-3 font-display text-base font-medium text-navy">{cat.tagline}</p>
							<ul class="mt-5 flex flex-col gap-2">
								{cat.items.map((item) => (
									<li class="flex items-center justify-between gap-4 rounded-lg bg-white px-4 py-2.5 font-display text-sm shadow-sm sm:text-base">
										<span class="font-medium text-brand-red">{item.name}</span>
										<span class="font-semibold text-navy tabular-nums">₹{item.price}</span>
									</li>
								))}
							</ul>
							<a
								href="#menu"
								class="mt-5 inline-flex items-center gap-2 rounded-full border-2 border-navy bg-white px-5 py-2 text-[11px] font-semibold tracking-widest text-navy uppercase transition-colors hover:bg-navy hover:text-white"
							>
								See all {cat.total} items <span aria-hidden="true">→</span>
							</a>
						</div>
					</article>
				))
			}
		</div>
	</div>
</section>
