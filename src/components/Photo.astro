---
import type { HTMLAttributes } from 'astro/types';

// A photo from /public when `src` is given; otherwise a colored stand-in block with a label.
interface Props extends HTMLAttributes<'div'> {
	label: string;
	color: string;
	src?: string;
}

const { label, color, src, class: className = '', ...rest } = Astro.props;
---

{
	src ? (
		<div
			{...rest}
			class:list={['relative overflow-hidden rounded-2xl', className]}
			style={`background-color:${color}`}
		>
			<img src={encodeURI(src)} alt={label} loading="lazy" decoding="async" class="absolute inset-0 size-full object-cover" />
		</div>
	) : (
		<div
			{...rest}
			role="img"
			aria-label={label}
			class:list={['relative flex items-end overflow-hidden rounded-2xl', className]}
			style={`background-color:${color};background-image:linear-gradient(135deg,rgba(255,255,255,.14) 0%,rgba(255,255,255,0) 55%,rgba(0,0,0,.18) 100%)`}
		>
			<span class="m-3 truncate rounded-full bg-black/25 px-3 py-1 text-[10px] font-bold tracking-widest text-white/90 uppercase backdrop-blur-sm">
				{label}
			</span>
		</div>
	)
}
